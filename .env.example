# Copie para .env.local e preencha (não commite segredos).
# GitHub → Settings → Secrets and variables → Actions: use os MESMOS nomes.
#
# URL: Project Settings → General → "Project ID" = ref. O URL é SEMPRE:
#   https://<Project ID>.supabase.co
# (ex.: id psuzqueoxdrveemuxcdg → https://psuzqueoxdrveemuxcdg.supabase.co)
#
# Chave: Project Settings → API Keys
#   • NOVO: separador "Publishable and secret" → copie a "Publishable" (sb_publishable_…)
#   • LEGADO: separador "Legacy anon, service_role" → copie anon / public (eyJ…)
# Pode usar UMA delas. Preferimos o nome abaixo para a publishable:

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co

VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Alternativa se só tiver a chave legada:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
